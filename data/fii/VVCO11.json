inhada juntamente com a proposta.","Ativo_Liquidez_Valor_Disponibilidades":"196.2","Ativo_Liquidez_Valor_Titulos_Publicos":"0","Ativo_Liquidez_Valor_Titulos_Privados":"0","Ativo_Liquidez_Valor_Fundos_Renda_Fixa":"173118.67"}}