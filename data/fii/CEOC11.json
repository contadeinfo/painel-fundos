 entrega. É aconselhável solicitar ao proponente que a minuta do contrato a ser celebrado seja encaminhada juntamente com a proposta.","Ativo_Liquidez_Valor_Disponibilidades":"0","Ativo_Liquidez_Valor_Titulos_Publicos":"0","Ativo_Liquidez_Valor_Titulos_Privados":"0","Ativo_Liquidez_Valor_Fundos_Renda_Fixa":"3931776"}}