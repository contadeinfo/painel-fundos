		<title>Investo lança primeiro ETF da B3 atrelado ao Índice de Energia Elétrica</title>
		<link>https://www.suno.com.br/noticias/investo-etf-lanca-powr11/</link>
		
		<dc:creator><![CDATA[Redação Suno Notícias]]></dc:creator>
		<pubDate>Fri, 20 Nov 2026 12:00:22 +0000</pubDate>
				<category><![CDATA[Negócios]]></category>
