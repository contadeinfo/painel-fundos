    <script>function getFormFields(form){const inputFields=form.querySelectorAll('input');const textareaFields=form.querySelectorAll('textarea');return[...inputFields,...textareaFields].reduce((p,c)=>{return{...p,[c.id]:c.value};},{});}
async function request(method,url,data){const options={method:method.toUpperCase(),mode:"cors",cache:"no-cache",credentials:"same-origin",headers:{"Content-Type":"application/json"},redirect:"follow",referrerPolicy:"no-referrer",};if(data!==undefined){options.body=JSON.stringify(data);}
const response=await fetch(url,options);return response.json();}
async function isAuthed(){const hasUserToken=document.cookie.split('; ').some(cookie=>cookie.startsWith('user_token='));if(!hasUserToken){return false;}
const response=await request('GET','/v1/accounts');return response.status==='success';}
async function signin(e){e.preventDefault();const fields=getFormFields(e.target);const button=e.target.querySelector('input[type="submit"]');const originalValue=button.value;button.value='Carregando...';let response;try{response=await request('PATCH','/v1/accounts',fields);}catch{showNotification('Não foi possível entrar. Tente novamente.');button.value=originalValue;return;}
button.value=originalValue;if(response.status==='success'){window.location.href="/dashboard";}else{showNotification('E-mail ou senha incorretos.');}}
function create(className,children){const el=document.createElement('div');el.classList.add(className);const childrenArray=Array.isArray(children)?children:[children];childrenArray.forEach(c=>{if(typeof c==='string'){el.innerHTML=c;}else{el.appendChild(c);}});return el;}
const allNotifications=[];function showNotification(message,className='error'){allNotifications.push({message:message,className:className,e:null,timeout:null,removed:false});const t=create('notifications',allNotifications.filter(n=>!n.removed).map(n=>{if(n.e)return n.e;const e=create(n.className,n.message);const to=setTimeout(()=>{e.remove();n.removed=true;},10000);n.e=e;n.timeout=to;return e;}));const curr=document.querySelector('.notifications');if(curr){curr.remove();}
document.querySelector('body').appendChild(t);}
async function signup(e){e.preventDefault();const fields=getFormFields(e.target);const button=e.target.querySelector('input[type="submit"]');const originalValue=button.value;button.value='Carregando...';let response;try{response=await request('POST','/v1/accounts',fields);}catch{showNotification('Não foi possível criar sua conta. Tente novamente.');button.value=originalValue;return;}
