    function drawChart(key) {
        document.querySelector('.chart').innerHTML = null;
        const values = data
            .map(d => ([d.date, d[key]]))
            .filter(([, value]) => value != null);
        const valuesma = movingAverage(values, 29, x => x[1], (x, v) => [x[0], v]);
        const chart = newChart('.chart');
        const histogram = chart.addHistogramSeries({
            color: 'rgba(48, 96, 252, 1.0)',
        });
        const line = chart.addLineSeries({
            color: 'rgba(255, 184, 108, 1.0)',
            lineWidth: 1.2,
        });
        histogram.setData(
            values.map(d => ({
                time: d[0],
                value: d[1] / 1000,
                color: d[1] < 0
                    ? 'rgba(255, 85, 85, 1.0)'
                    : 'rgba(48, 96, 252, 1.0)',
            }))
        );
        line.setData(valuesma.map(d => ({ time: d[0], value: d[1] / 1000 })));
        chart.timeScale().fitContent();
    }
    drawChart('foreigners');

    document
        .getElementById("download-csv")
        .addEventListener("click", () => downloadTableCsv("#flow", "fluxo-estrangeiro.csv"));

    // Dropdown
    const dropdown = document.querySelectorAll('.dropdown');
    dropdown.forEach(d => {
        d.addEventListener('click', () => {
            d.classList.add('open');
        });

        document.querySelectorAll('.dropdown div span').forEach(i => {
            i.addEventListener('click', () => {
                d.classList.remove('open');
                document.querySelector('.dropdown h2 span').innerHTML = `Fluxo ${i.innerHTML.toLowerCase()}`;

                const m = {
                    'Estrangeiro': 'foreigners',
                    'Institucional': 'institutional',
                    'Pessoa física': 'individuals',
                    'Inst. Financeira': 'financial_institutions',
                    'Outros': 'other',
                };

                setTimeout(() => {
                    d.classList.remove('open');
                }, 100);

                drawChart(m[i.innerHTML]);
            });
        });

        document.body.addEventListener('click', function (e) {
            if (!d.contains(e.target)) {
                d.classList.remove('open');
            }
        });
    });
</script>

