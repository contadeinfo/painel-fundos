	<item>
		<title>Hapvida (HAPV3) diz que não há decisão concreta sobre venda de ativos após questionamento da CVM</title>
		<link>https://www.moneytimes.com.br/hapvida-hapv3-diz-que-nao-ha-decisao-concreta-sobre-venda-de-ativos-apos-questionamento-da-cvm/</link>
		
		<dc:creator><![CDATA[Maria Carolina Abe]]></dc:creator>
		<pubDate>Sat, 21 Nov 2026 11:37:50 +0000</pubDate>
