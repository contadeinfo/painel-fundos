		<title>IPO trilionário da Anthropic: como dona do Claude ganha dinheiro e enfrenta corrida da IA</title>
		<link>https://www.moneytimes.com.br/ipo-da-anthropic-deixa-em-evidencia-rapido-crescimento-de-custos/</link>
		
		<dc:creator><![CDATA[Reuters]]></dc:creator>
		<pubDate>Sat, 21 Nov 2026 11:00:00 +0000</pubDate>
				<category><![CDATA[Empresas]]></category>
		<category><![CDATA[Ações Americanas]]></category>
		<category><![CDATA[Amazon]]></category>
		<category><![CDATA[Anthropic]]></category>
		<category><![CDATA[Canal WhatsApp]]></category>
		<category><![CDATA[Feed Principal]]></category>
		<category><![CDATA[Google]]></category>
		<category><![CDATA[Inteligência Artificial]]></category>
		<category><![CDATA[IPO]]></category>
		<category><![CDATA[Microsoft]]></category>
		<category><![CDATA[Nasdaq]]></category>
		<category><![CDATA[OpenAI]]></category>
		<category><![CDATA[Reuters]]></category>
