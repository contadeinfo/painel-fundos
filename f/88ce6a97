files/thumbnails/image/loading_v2.gif&quot; alt=&quot;&quot; title=&quot;&quot; /&gt;&lt;noscript&gt;&lt;img data-title=&quot;A deputada Benedita da Silva, em 1987&quot; data-big=&quot;https://imagens.ebc.com.br/R9QQN48yz7v0b0LYcj67v0caWIc=/1024x768/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/45912562125_a2578e533e_o.jpg?itok=iNiRR3XH&quot; data-authors=&quot;geledes.org.br&quot; data-description=&quot;&quot; src=&quot;https://imagens.ebc.com.br/PoHxQpXqxrcLAnwS1B3eIcZAypc=/48x0/smart/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/45912562125_a2578e533e_o.jpg?itok=aeYSkks7&quot; alt=&quot;&quot; title=&quot;&quot; /&gt;&lt;/noscript&gt;&lt;/a&gt;      &lt;a href=&quot;https://imagens.ebc.com.br/GlXGeoieT4VGFAF9C0ZjRt3uG1U=/754x0/smart/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/hwk7nctx0aa6bd8.jpg?itok=9uINdExp&quot;&gt;&lt;img data-title=&quot;As deputadas Benedita da Silva e Ana Elisa&quot; data-big=&quot;https://imagens.ebc.com.br/bKtw0-ATdhkxnHydgGyhzk9ITHU=/1024x768/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/hwk7nctx0aa6bd8.jpg?itok=vwYhBgPL&quot; data-authors=&quot;@dasilvabenedita/X&quot; data-description=&quot;&quot; data-echo=&quot;https://imagens.ebc.com.br/zhWuVTXpQ2Nxg5Y6YNu3uSGdVkk=/48x0/smart/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/hwk7nctx0aa6bd8.jpg?itok=rBlP3ZsP&quot; data-icon=&quot;&quot; src=&quot;/sites/default/files/thumbnails/image/loading_v2.gif&quot; alt=&quot;&quot; title=&quot;&quot; /&gt;&lt;noscript&gt;&lt;img data-title=&quot;As deputadas Benedita da Silva e Ana Elisa&quot; data-big=&quot;https://imagens.ebc.com.br/bKtw0-ATdhkxnHydgGyhzk9ITHU=/1024x768/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/hwk7nctx0aa6bd8.jpg?itok=vwYhBgPL&quot; data-authors=&quot;@dasilvabenedita/X&quot; data-description=&quot;&quot; src=&quot;https://imagens.ebc.com.br/zhWuVTXpQ2Nxg5Y6YNu3uSGdVkk=/48x0/smart/https://agenciabrasil.ebc.com.br/sites/default/files/thumbnails/image/2026/11/26/hwk7nctx0aa6bd8.jpg?itok=rBlP3ZsP&quot; alt=&quot;&quot; title=&quot;&quot; /&gt;&lt;/noscript&gt;&lt;/a&gt;  &lt;/div&gt;
